# Exemplo de configuração do Formiga (TOML).
#
# Uso: copie para `formiga.toml` no diretório do projeto (ignorado pelo git)
# ou aponte `--config` / `FORMIGA_CONFIG` para o arquivo. Sem arquivo, a
# configuração vem de variáveis de ambiente e da CLI.
#
# Precedência: CLI > variáveis de ambiente > arquivo > defaults.

[llm]
# Backend do modelo: "ollama" | "llamacpp" | "openai" (remoto OpenAI-compatível).
# Foco do Formiga: família Gemma 4 local via Ollama (sem chave).
backend = "ollama"
# Default: Gemma 4 E4B (Ollama `gemma4:e4b`; perfil builtin gemma4-e4b).
model = "gemma4:e4b"
# Outros modelos da família/alternativas:
# model = "gemma4:e2b"                        # perfil gemma4-e2b (thinking on)
# model = "nemotron-3.5-bolt"                 # tuning da NVIDIA do E4B
#
# Para backend remoto (NIM, OpenAI, vLLM...), descomente:
# backend = "openai"
# base_url = "https://integrate.api.nvidia.com/v1"
# api_key_env = "NVIDIA_API_KEY"   # nome da variável, nunca a chave (ver .env.example)
temperature = 1.0
timeout_seconds = 120.0
# Retries HTTP para 429/5xx no backend remoto, com backoff e Retry-After.
max_retries = 2
# Thinking: o default global é ligado; o perfil gemma4-e4b (ativo com o
# modelo default) o desliga no agent. Use isto para forçar um valor.
# thinking = false

# Nota: o endpoint do llama-server não tem chave neste arquivo — use
# FORMIGA_LLAMACPP_URL (ambiente) ou --llamacpp-url (CLI).

# Backup opt-in: só ativa se você descomentar. Após a primeira falha de
# transporte do backend principal, o backup assume e permanece pelo resto
# da execução (circuit breaker).
# fallback_backend = "ollama"
# fallback_after_failures = 1

[search]
searxng_url = "http://localhost:8080"

[budget]
max_searches = 12
max_pages = 18
max_llm_calls = 40
timeout_seconds = 900

[extensions]
# Ordem de carregamento = ordem desta lista.
enabled = ["core", "web", "deepsearch", "memory", "skills"]
# Diretórios de projeto cujo .formiga/ carrega (allowlist global).
trusted_projects = []

# Perfil de modelo (§9.6 do PRD). Sem destes, o perfil é escolhido pela
# substring do nome do modelo (ex.: gemma4:e4b → gemma4-e4b).
[profile]
# model_hint = "gemma4-e4b"      # força um perfil (nome exato)
# active = "gemma4-e2b"          # alternativa: perfil "ativo"
# Obs.: a tag do Ollama `nemotron-3.5-bolt` não casa por substring — use
# active = "nemotron-3.5-bolt-e4b" para forçar o perfil do Bolt.

# Perfis de modelo (§9.6 do PRD): seleção por substring do nome do modelo.
# Os builtin são gemma4-e2b, gemma4-e4b e nemotron-3.5-bolt-e4b; o que está
# aqui mescla sobre o builtin correspondente.
[profiles.gemma4-e2b]
context_tokens = 32768       # janela útil, não a anunciada
thinking = true              # GGUF "IT ... Thinking": raciocínio ligado
temperature = 1.0
top_p = 0.95
max_tokens_per_turn = 8192   # thinking consome orçamento de geração
tool_schema_tokens = 1600

[profiles.gemma4-e4b]
context_tokens = 32768       # janela útil, não a anunciada
thinking = false
temperature = 1.0
top_p = 0.95
max_tokens_per_turn = 4096
tool_schema_tokens = 1600

# Nemotron 3.5 Bolt: pós-treinamento (RL) da NVIDIA a partir do
# Gemma-4-E4B-it — alternativa ao E4B para tool use/saída estruturada.
# Aspas são obrigatórias: o nome tem pontos (TOML os trata como separador).
[profiles."nemotron-3.5-bolt-e4b"]
thinking = true
temperature = 1.0
top_p = 0.95

[agent]
# Harness agêntico (docs/prd_agent.md).
max_turns = 24
max_llm_calls = 120
timeout_seconds = 1800
max_deep_searches = 2
max_web_searches = 6
max_web_fetches = 8
tool_result_chars = 4000
workdir = "."

[cron]
# Catchup quando o gateway está parado na hora marcada: "skip" (default) ou "once".
catchup = "skip"
# Fuso dos schedules; None = fuso do sistema.
tz = "America/Sao_Paulo"

[memory]
# Índice FTS5 ativo / recall disponível.
recall = true
# Nudge de memória curada no fim da sessão (e a cada 10 turnos).
nudge = true
# Teto rígido de tokens injetados no prompt (memória + perfil).
max_tokens = 1600
