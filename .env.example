# Exemplo de arquivo de segredos do Formiga.
# Copie para `.env` (ignorado pelo git) e preencha com o valor real.
# Permissão recomendada: chmod 600 .env
#
# O .env apenas PREENCHE variáveis ausentes — o que já estiver definido no
# ambiente vence (ex.: `export NVIDIA_API_KEY=...` sobrepõe o arquivo).
# Caminho alternativo: FORMIGA_ENV_FILE=caminho/para/secrets.env

# --- Chave do backend remoto (única variável realmente secreta) ---
# Backend OpenAI-compatível (NVIDIA NIM, OpenAI, DeepSeek, vLLM...), lida
# conforme `api_key_env` da configuração (default: NVIDIA_API_KEY).
# A chave nunca vai na CLI e nunca aparece em logs, eventos ou relatórios.
NVIDIA_API_KEY=

# --- Backend e endpoints ---
# FORMIGA_LLM_BACKEND=ollama          # ollama | llamacpp | openai
# FORMIGA_MODEL=nemotron-3.5-bolt     # nome no Ollama ou ID no backend remoto
# FORMIGA_OLLAMA_URL=http://localhost:11434
# FORMIGA_LLAMACPP_URL=http://localhost:8080   # endpoint do llama-server
# FORMIGA_OPENAI_URL=https://integrate.api.nvidia.com/v1
# FORMIGA_OPENAI_API_KEY_ENV=NVIDIA_API_KEY    # nome da variável com a chave
# FORMIGA_SEARXNG_URL=http://localhost:8080

# --- Failover opt-in (backup; nunca automático) ---
# FORMIGA_FALLBACK_BACKEND=ollama     # ollama | llamacpp | openai
# FORMIGA_FALLBACK_AFTER_FAILURES=1   # falhas consecutivas antes do backup assumir

# --- Modelo: amostragem, tempos e raciocínio ---
# FORMIGA_LLM_TEMPERATURE=1.0         # ficha do Nemotron Bolt recomenda 1.0
# FORMIGA_LLM_TIMEOUT=300             # timeout por chamada ao modelo (segundos)
# FORMIGA_LLM_THINKING=1              # 0 = desligar o raciocínio (default: 1)
# FORMIGA_LLAMACPP_THINKING=1         # override do thinking só no llama.cpp
# FORMIGA_AGENT_MAX_TURNS=24
# FORMIGA_AGENT_MAX_LLM_CALLS=120
# FORMIGA_AGENT_TIMEOUT_SECONDS=1800
# FORMIGA_AGENT_MAX_CONTEXT_TOKENS=32768
# FORMIGA_AGENT_TOOL_SCHEMA_TOKENS=1600
# FORMIGA_PROFILE_MODEL_HINT=
# FORMIGA_EXTENSIONS_ENABLED=core,web,deepsearch

# --- Orçamentos da execução ---
# FORMIGA_MAX_SEARCHES=12
# FORMIGA_MAX_PAGES=18
# FORMIGA_MAX_LLM_CALLS=40
# FORMIGA_TIMEOUT_SECONDS=900

# --- Caminhos ---
# FORMIGA_CONFIG=caminho/formiga.toml
# FORMIGA_ENV_FILE=caminho/secrets.env
