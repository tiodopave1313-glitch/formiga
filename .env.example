# Exemplo de arquivo de segredos do Formiga.
# Copie para `.env` (ignorado pelo git) e preencha com o valor real.
# Permissão recomendada: chmod 600 .env

# Chave do backend remoto OpenAI-compatível (NVIDIA NIM, OpenAI, etc.),
# lida conforme `api_key_env` da configuração (default: NVIDIA_API_KEY).
NVIDIA_API_KEY=

# Outras variáveis FORMIGA_* também funcionam aqui (o .env apenas preenche
# o que não está definido no ambiente):
# FORMIGA_LLM_BACKEND=openai
# FORMIGA_OPENAI_URL=https://integrate.api.nvidia.com/v1
# FORMIGA_MODEL=nvidia/nemotron-3.5-bolt-e4b
# FORMIGA_LLM_THINKING=1        # default 1; 0 = desligar o raciocínio
# FORMIGA_LLAMACPP_THINKING=1   # override do thinking só no llama.cpp
